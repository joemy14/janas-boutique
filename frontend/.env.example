# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/janasboutique"
# Random string, at least 32 characters (signs login cookies)
SESSION_SECRET=generate-a-32-character-random-string
# Backend base URL (without the /backend suffix)
NEXT_PUBLIC_API_URL=https://your-infinityfree-domain.example/janas-boutique
# Use production for deployed cookies; keep development for local HTTP.
APP_ENV=development
# Public URL of the site, used in password-reset links
APP_URL="http://localhost:3000"
# Admin account created/updated by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
# Gmail address + app password for receipts and reset emails
GMAIL_USER=""
GMAIL_PASS=""
